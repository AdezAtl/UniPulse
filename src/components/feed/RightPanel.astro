---
import { getEvents, getRegisteredEvents, getAllUsers, getFollowingIds } from "../../lib/db";

const user = Astro.locals.user!;
const events = (await getEvents()).slice(0, 4);
const allUsers = await getAllUsers();
const followingIds = await getFollowingIds(user.id);

// Get suggestions: not self, not followed, not banned, limit 3
const suggestions = allUsers
  .filter(u => u.id !== user.id && !followingIds.has(u.id) && !u.is_banned)
  .slice(0, 3);
---

<div class="panel-wrap">
  <!-- Stories Section -->
  <h3 class="stories-section-title">Stories</h3>
  <div class="stories-list">
    {events.length === 0 ? (
      <div class="empty-text" style="font-size: 0.75rem;">No recent events.</div>
    ) : (
      events.map((event, idx) => {
        const grads = [
          'linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%)',
          'linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%)',
          'linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%)',
          'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)',
        ];
        const grad = grads[idx % grads.length];
        const avatarUrl = `https://api.dicebear.com/7.x/avataaars/svg?seed=${event.author_username || 'event'}`;
        return (
          <a href={`/search?q=${encodeURIComponent(event.title)}&tab=events`} class="story-card">
            <div class="story-card-bg" style={`background: ${grad}`}></div>
            <div class="story-card-overlay">
              <div class="story-avatar-ring">
                <img class="story-avatar" src={avatarUrl} alt="" />
              </div>
              <h4 class="story-title">{event.title}</h4>
            </div>
          </a>
        );
      })
    )}
  </div>

  <!-- Suggestions Section -->
  {suggestions.length > 0 && (
    <div class="suggestions-section" style="margin-bottom: 1.5rem;">
      <h3 class="stories-section-title" style="margin-bottom: 0.75rem;">Suggestions</h3>
      <div class="suggestions-list">
        {suggestions.map(u => (
          <div class="suggest-item">
            <div class="flex items-center gap-2">
              <div class="avatar avatar-sm">
                {u.avatar_url ? (
                  <img src={u.avatar_url} alt="" />
                ) : (
                  <img src={`https://api.dicebear.com/7.x/avataaars/svg?seed=${u.username}`} alt="" />
                )}
              </div>
              <div>
                <div class="cell-name" style="font-size: 0.8125rem; font-weight: 600; color: var(--text-1)">{u.full_name || u.username}</div>
                <div class="cell-username" style="font-size: 0.7rem; color: var(--text-3)">@{u.username}</div>
              </div>
            </div>
            <button class="suggest-btn follow-btn" data-user-id={u.id}>Follow</button>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Recent Section -->
  <div class="recent-section">
    <h3 class="recent-section-title">Recent</h3>
    <div class="recent-list">
      <a href="/s/compsci" class="recent-item">
        <span class="sub-icon" style="background:#3b82f6"></span>
        s/compsci
      </a>
      <a href="/s/engineering" class="recent-item">
        <span class="sub-icon" style="background:#ef4444"></span>
        s/engineering
      </a>
      <a href="/s/campuslife" class="recent-item">
        <span class="sub-icon" style="background:#10b981"></span>
        s/campuslife
      </a>
      <a href="/s/events" class="recent-item">
        <span class="sub-icon" style="background:#f59e0b"></span>
        s/events
      </a>
    </div>
  </div>

  <p class="panel-footer" style="font-size: .75rem; color: var(--text-3); text-align: center; margin-top: 2rem;">UniPulse · Campus Edition</p>
</div>

<style>
  .panel-wrap {
    display: flex;
    flex-direction: column;
    padding-left: 1rem;
  }
  .empty-text {
    font-size: .875rem;
    color: var(--text-2);
    text-align: center;
    padding: 1rem 0;
  }
  .recent-section {
    margin-top: 1.5rem;
  }
  .recent-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.875rem;
  }
  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .recent-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }
  .recent-item:hover {
    background: var(--bg-2);
    color: var(--text-1);
    transform: translateX(4px);
  }
  .sub-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }
  .recent-item:hover .sub-icon {
    transform: scale(1.1);
  }
</style>
