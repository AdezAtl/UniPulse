---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Sidebar from '../components/feed/Sidebar.astro';
import RightPanel from '../components/feed/RightPanel.astro';
import type { User } from '../lib/db';
interface Props {
  title?: string;
  activeNav?: string;
  user: User | null;
  showRightPanel?: boolean;
}
const { title, activeNav = 'feed', user, showRightPanel = true } = Astro.props;
---
<BaseLayout title={title}>
  <div class="dashboard-wrapper">
    <Header user={user} />
    <div class="app-shell">
      <aside class="sidebar-col"><Sidebar activeNav={activeNav} user={user} /></aside>
      <main class="feed-col" id="main-content"><slot /></main>
      {showRightPanel && <aside class="panel-col"><RightPanel /></aside>}
    </div>
  </div>
  <nav class="mobile-nav">
    <a href="/feed" class={`mobile-nav-item ${activeNav === 'feed' ? 'active' : ''}`} aria-label="Feed">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
    </a>
    <a href="/events" class={`mobile-nav-item ${activeNav === 'events' ? 'active' : ''}`} aria-label="Events">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
    </a>
    <a href="/resources" class={`mobile-nav-item ${activeNav === 'resources' ? 'active' : ''}`} aria-label="Resources">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
    </a>
    <a href="/news" class={`mobile-nav-item ${activeNav === 'news' ? 'active' : ''}`} aria-label="News">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a4 4 0 0 1-4 4z"></path><line x1="10" y1="7" x2="18" y2="7"></line></svg>
    </a>
  </nav>
  
  <!-- Mobile Messages FAB -->
  {!Astro.url.pathname.startsWith('/messages') && (
    <a href="/messages" class="mobile-message-fab" aria-label="Messages">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </a>
  )}

  <div id="toast-container" class="toast-container"></div>
</BaseLayout>
<style>
.app-shell { display:grid; grid-template-columns:var(--nav-w) minmax(0,1fr) var(--panel-w); width:100%; margin:0 auto; height:calc(100vh - 60px); overflow:hidden; }
.sidebar-col { height:100%; overflow-y:auto; scrollbar-width:none; padding-top:1.5rem; padding-left:1rem; transition: transform 0.3s var(--ease); z-index: 40; background: var(--bg); }
.sidebar-col::-webkit-scrollbar { display:none; }
.feed-col    { height:100%; overflow-y:auto; padding: 1.5rem 1.5rem 0; }
.panel-col   { height:100%; overflow-y:auto; scrollbar-width:none; padding-top:1.5rem; padding-right:1rem; }
.panel-col::-webkit-scrollbar { display:none; }
.mobile-nav  { display:none; position:fixed; bottom:0; left:0; right:0; height:60px; background:var(--bg); border-top:1px solid var(--border); z-index:40; justify-content:space-around; align-items:center; padding:0 1rem; transition: transform 0.3s var(--ease); }
.mobile-nav-item { display:flex; align-items:center; justify-content:center; width:44px; height:44px; border-radius:12px; color:var(--text-3); transition:color 0.15s, background 0.15s; }
.mobile-nav-item.active { color:var(--text-1); }
.mobile-nav-item:hover { background:var(--bg-2); color:var(--text-2); }

.mobile-message-fab {
  display: none;
}

@media (max-width:1024px) { 
  .app-shell { grid-template-columns:var(--nav-w) minmax(0,1fr); } 
  .panel-col { display:none; } 
}

@media (max-width:640px) {
  .mobile-message-fab {
    display: flex;
    position: fixed;
    bottom: 80px;
    right: 20px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--text-1);
    color: var(--bg);
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    z-index: 99;
    transition: transform 0.15s ease;
  }
  .mobile-message-fab:active {
    transform: scale(0.95);
  }
  .mobile-message-fab .indicator-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background: var(--red);
    color: white;
    font-size: 0.65rem;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 99px;
    line-height: 1;
    pointer-events: none;
  } 
  .app-shell { grid-template-columns:1fr; padding-bottom:60px; } 
  .feed-col { padding: 1.5rem 1rem 0; }
  .sidebar-col { 
    display: block !important; 
    position: fixed; 
    top: 60px; 
    left: 0; 
    bottom: 0; 
    z-index: 50;
    width: 280px; 
    transform: translateX(-100%); 
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem;
    box-shadow: 4px 0 16px rgba(0,0,0,0.1);
  } 
  :global(.mobile-sidebar-open) .sidebar-col { transform: translateX(0); }
  :global(.mobile-sidebar-open) .mobile-nav { transform: translateY(100%); }
  .mobile-nav { display:flex; } 
  .mobile-nav-hidden { transform: translateY(100%); }
}
</style>

<script>
  // Global Toast function
  (window as any).showToast = function(message: string, type: string = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;

    let icon = '⚡';
    if (message.toLowerCase().includes('success') || message.toLowerCase().includes('copied') || message.toLowerCase().includes('posted')) {
      icon = '✓';
    } else if (message.toLowerCase().includes('fail') || message.toLowerCase().includes('error')) {
      icon = '⚠️';
    }

    toast.innerHTML = `<span class="toast-icon">${icon}</span><span>${message}</span>`;
    container.appendChild(toast);
    
    // Trigger reflow
    toast.offsetHeight;
    toast.classList.add('show');
    
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 3200);
  };

  // Check for pending toasts
  const pendingToast = sessionStorage.getItem('showToast');
  if (pendingToast) {
    (window as any).showToast(pendingToast);
    sessionStorage.removeItem('showToast');
  }

  // Mobile nav auto-hide on scroll
  let lastScrollY = window.scrollY;
  window.addEventListener('scroll', () => {
    if (window.innerWidth <= 640) {
      const currentScrollY = window.scrollY;
      const nav = document.querySelector('.mobile-nav');
      if (nav && !document.body.classList.contains('mobile-sidebar-open')) {
        if (currentScrollY > lastScrollY && currentScrollY > 60) {
          nav.classList.add('mobile-nav-hidden');
        } else {
          nav.classList.remove('mobile-nav-hidden');
        }
      }
      lastScrollY = currentScrollY;
    }
  }, { passive: true });

  // Simple Real-Time Updates Poller
  let initialPostTime: string | null = null;
  const isFeedPage = window.location.pathname === '/feed';

  let lastUnreadNotifications = -1;
  let lastUnreadMessages = -1;

  async function checkUpdates() {
    try {
      const res = await fetch('/api/updates');
      if (!res.ok) return;
      const data = await res.json();
      
      if (!initialPostTime && data.latestPostTime) {
        initialPostTime = data.latestPostTime;
      }

      // Check for new posts
      if (isFeedPage && initialPostTime && data.latestPostTime && data.latestPostTime > initialPostTime) {
        let banner = document.getElementById('new-posts-banner');
        if (!banner) {
          banner = document.createElement('div');
          banner.id = 'new-posts-banner';
          banner.className = 'new-posts-banner';
          banner.innerHTML = '<button onclick="window.location.reload()">New posts available. Click to refresh.</button>';
          const mainContent = document.getElementById('main-content');
          if (mainContent) {
            mainContent.insertBefore(banner, mainContent.firstChild);
          }
        }
      }

      // Update Messages indicator
      const msgBtns = document.querySelectorAll('a[aria-label="Messages"]');
      msgBtns.forEach(msgBtn => {
        let badge = msgBtn.querySelector('.indicator-badge');
        if (data.unreadMessages > 0) {
          if (!badge) {
            badge = document.createElement('span');
            badge.className = 'indicator-badge';
            msgBtn.appendChild(badge);
          }
          badge.textContent = data.unreadMessages.toString();
        } else if (badge) {
          badge.remove();
        }
      });

      // Update Notifications indicator
      const notifBtns = document.querySelectorAll('[aria-label="Notifications"]');
      notifBtns.forEach(notifBtn => {
        let badge = notifBtn.querySelector('.indicator-badge');
        if (data.unreadNotifications > 0) {
          if (!badge) {
            badge = document.createElement('span');
            badge.className = 'indicator-badge';
            notifBtn.appendChild(badge);
          }
          badge.textContent = data.unreadNotifications.toString();
        } else if (badge) {
          badge.remove();
        }
      });

      // Live Toast notifications for new events
      if (lastUnreadNotifications !== -1 && data.unreadNotifications > lastUnreadNotifications) {
        const diff = data.unreadNotifications - lastUnreadNotifications;
        const newNotifs = data.latestNotifications || [];
        for (let i = 0; i < Math.min(diff, newNotifs.length); i++) {
          const item = newNotifs[i];
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast(item.message);
          }
        }
      }
      lastUnreadNotifications = data.unreadNotifications;

      // Live Toast notifications for new messages
      const activeChatUser = window.location.pathname.startsWith('/messages/') ? window.location.pathname.split('/').pop() : null;
      if (lastUnreadMessages !== -1 && data.unreadMessages > lastUnreadMessages) {
        const diff = data.unreadMessages - lastUnreadMessages;
        const newMsgs = data.latestMessages || [];
        let hasActiveChatMsg = false;
        
        for (let i = 0; i < Math.min(diff, newMsgs.length); i++) {
          const item = newMsgs[i];
          if (item.username === activeChatUser) {
            const messagesContainer = document.getElementById('chat-messages');
            if (messagesContainer) {
              const wrapper = document.createElement('div');
              wrapper.className = 'msg-wrapper';
              wrapper.innerHTML = `<div class="msg-bubble theirs">${item.content}</div>`;
              
              const emptyState = messagesContainer.querySelector('.empty-state');
              if (emptyState) emptyState.remove();
              
              messagesContainer.appendChild(wrapper);
              messagesContainer.scrollTop = messagesContainer.scrollHeight;
              hasActiveChatMsg = true;
            }
          } else {
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast(`@${item.username}: ${item.content}`);
            }
          }
        }

        if (hasActiveChatMsg && activeChatUser) {
          fetch('/api/messages/read', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ senderUsername: activeChatUser })
          }).catch(() => {});
        }
      }
      lastUnreadMessages = data.unreadMessages;

    } catch (e) {
      // ignore
    }
  }

  // Poll every 5 seconds
  setInterval(checkUpdates, 5000);
  // Initial check
  setTimeout(checkUpdates, 1000);

  // Global follow buttons handler via delegation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.follow-btn');
    if (!btn) return;
    
    const followingId = (btn as HTMLElement).dataset.userId;
    if (!followingId) return;
    
    try {
      const res = await fetch("/api/follows", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ followingId }),
      });
      if (res.ok) {
        const { following } = await res.json();
        // Update all buttons following this user
        document.querySelectorAll(`.follow-btn[data-user-id="${followingId}"]`).forEach(b => {
          b.textContent = following ? "Following" : "Follow +";
          if (following) {
            b.classList.add('following');
          } else {
            b.classList.remove('following');
          }
        });
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(
            following ? "You are now following this user" : "You unfollowed this user"
          );
        }
      }
    } catch (err) {
      // ignore
    }
  });
</script>

<style is:global>
  .toast-container {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 99999;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .toast-container {
      bottom: 84px;
    }
  }
  .toast {
    background: var(--toast-bg, #0f0f12);
    color: var(--toast-color, #ffffff);
    border: 1px solid var(--toast-border, rgba(255, 255, 255, 0.18));
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow: var(--toast-shadow, 0 10px 30px -4px rgba(0,0,0,0.35));
    opacity: 0;
    transform: translateY(16px) scale(0.95);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 90vw;
    line-height: 1.3;
    backdrop-filter: blur(8px);
  }
  .toast.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .toast-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: bold;
  }

  .indicator-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    background: var(--red);
    color: white;
    font-size: 0.6rem;
    font-weight: bold;
    padding: 2px 4px;
    border-radius: 99px;
    line-height: 1;
    pointer-events: none;
  }
  .header-icon-btn { position: relative; } /* Ensure badge positions correctly */
  
  .new-posts-banner {
    margin-bottom: 1rem;
    text-align: center;
  }
  .new-posts-banner button {
    background: var(--accent);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 99px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.4);
    transition: transform 0.1s;
  }
  .new-posts-banner button:active {
    transform: scale(0.95);
  }
</style>
